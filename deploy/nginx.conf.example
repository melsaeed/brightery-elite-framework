# Put only /public under the web root. Adjust PHP-FPM socket for your host.
server {
    listen 80;
    server_name example.com;
    root /var/www/brightery-framework/public;
    index index.php;
    server_tokens off;
    client_max_body_size 32m;
    charset utf-8;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml;
    # Enable Brotli at the reverse proxy only when its module is installed.

    # Invitation URLs contain bearer secrets. Do not record their request path in access logs.
    location ^~ /invite/ {
        access_log off;
        try_files $uri $uri/ /index.php?$query_string;
    }
    # Recovery / verification links also contain bearer secrets; never persist full paths.
    location ^~ /reset-password/ {
        access_log off;
        try_files $uri $uri/ /index.php?$query_string;
    }
    location ^~ /verify-email/ {
        access_log off;
        try_files $uri $uri/ /index.php?$query_string;
    }
    location / { try_files $uri $uri/ /index.php?$query_string; }
    location ~* ^/assets/build/.*\.(css|js)$ {
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
        try_files $uri =404;
    }
    location ~* ^/assets/.*\.(css|js|svg|png|jpg|webp|woff2)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        access_log off;
        try_files $uri =404;
    }
    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param HTTP_PROXY "";
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        fastcgi_hide_header X-Powered-By;
    }
    location ~ /\. { deny all; }
}
