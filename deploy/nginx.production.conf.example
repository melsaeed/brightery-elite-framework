# Production template. Replace server_name, certificate paths, root and PHP-FPM socket.
# Cloudflare/CloudPanel users should merge these locations into the generated vhost.
# Configure Full (strict) TLS between Cloudflare and origin; do not expose port 80 to PHP.
server {
    listen 80;
    server_name app.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl http2;
    server_name app.example.com;
    ssl_certificate /etc/letsencrypt/live/app.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /srv/brightery-framework/public;
    index index.php;
    server_tokens off;
    charset utf-8;
    client_max_body_size 32m;
    client_body_timeout 20s;
    fastcgi_read_timeout 60s;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml;

    # Deny script execution outside the trusted front controller.
    location ~ /\. { deny all; }
    location ~ \.php$ { return 404; }
    location ^~ /assets/build/ {
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
        try_files $uri =404;
    }
    location ^~ /assets/ {
        expires 7d;
        access_log off;
        try_files $uri =404;
    }
    # Sensitive credentials in path segments must not be logged by origin/CDN.
    location ~ ^/(invite|reset-password|verify-email)/ {
        access_log off;
        try_files $uri /index.php?$query_string;
    }
    location / { try_files $uri $uri/ /index.php?$query_string; }
    location = /index.php {
        internal;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        fastcgi_param HTTPS on;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        fastcgi_hide_header X-Powered-By;
    }
}
