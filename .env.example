APP_NAME="Brightery Framework"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_KEY=REPLACE_WITH_GENERATED_64_HEX_CHAR_KEY
APP_LOCALE=en
APP_TIMEZONE=UTC
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=brightery
DB_USERNAME=brightery
DB_PASSWORD=
CACHE_DRIVER=file
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
SESSION_SECURE=false
TRUSTED_HOSTS=127.0.0.1,localhost

# single: no tenant DB queries for routing; multi: exact active-domain lookup (fail closed)
TENANCY_MODE=single
# Required when TENANCY_MODE=multi; must be a trusted control-plane hostname
TENANCY_CONTROL_HOST=admin.example.com

# tenant workspaces & invitations: no additional secrets or flags required.
# CRITICAL: configure TLS and SESSION_SECURE=true in production.
# invitation links are queued and emailed to recipients using the encrypted mail outbox.
# Run the queue worker and configure verified SMTP before issuing invitations.
# Redact /invite/{token} paths from web/CDN logs.

# API, queue & MFA settings
# Add Nginx fastcgi_param HTTP_AUTHORIZATION $http_authorization; for bearer APIs.
# Run queue workers only under PHP CLI; configure separate scheduler/worker processes.
# Changing APP_KEY invalidates all encrypted authenticator secrets; retain securely for rollback.
# Rotate APP_KEY only with a tested re-enrollment/reencryption plan.

# mail: disabled / smtp / log (log is restricted to APP_ENV=local).
MAIL_DRIVER=disabled
MAIL_FROM=noreply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# 465 = implicit TLS; other ports require STARTTLS and verified server certificate.
# After migration 005, the registry enforces revocable, tenant-bound sessions.
SESSION_REGISTRY_ENABLED=true
# Ensure no credentials or /verify-email/<token> paths are written to proxy access logs.

# password reset requires SMTP outbox, APP_KEY and the queue worker.
# Redact /reset-password/{token} from access logs; no APP_KEY or SMTP credentials in code.
# Server-side private JPEG/PNG/WebP transforms require the gd PHP extension.

# media quotas are counted for originals AND derived images.
# Per-tenant overrides can be changed in Admin > Tenants. Default applies to central and tenants.
MEDIA_QUOTA_BYTES=536870912
MEDIA_QUOTA_FILES=2000
# Images enqueue a 320x320 private thumbnail when stored. Requires ext-gd + supervised queue worker.
MEDIA_AUTO_THUMBNAILS=true
# Antivirus: disabled (not malware-scanned), or clamav (UNIX clamd socket; fails closed on errors).
# Set MEDIA_SCAN_REQUIRED=true to forbid disabled scanner configuration.
MEDIA_SCAN_DRIVER=disabled
MEDIA_SCAN_REQUIRED=false
CLAMAV_SOCKET=/run/clamav/clamd.ctl
# Mail templates: en or ar, otherwise uses APP_LOCALE, and falls back to en.
MAIL_LOCALE=en

# operations: explicit maintenance during release finalization or media counter repair.
# These flags never automatically stop traffic. Stop traffic/workers externally first.
DEPLOY_MAINTENANCE=false
MEDIA_RECONCILE_MAINTENANCE=false
# A long-running queue handler must renew its job lease; heartbeat alone is not enough.

# privacy-aware HTTP and queue JSONL telemetry. Requires private writable storage/logs.
# info records request status/latency; error records only 5xx/worker failures;
# critical suppresses them (no request metrics). Keep outside the public webroot.
LOG_LEVEL=info

# admin module generation is read-only in production unless explicitly enabled.
# Set true only during a controlled maintenance window; disable afterwards.

# visual schema evolution in production requires BOTH maintenance flags.
# The app cannot stop external web traffic or background workers automatically.
MAINTENANCE_MODE=false
MODULE_BUILDER_MAINTENANCE=false
# signed package install/rollback in APP_ENV=production requires explicit
# maintenance opt-in. Also stop web traffic/workers externally before applying.
MODULE_MAINTENANCE=false
